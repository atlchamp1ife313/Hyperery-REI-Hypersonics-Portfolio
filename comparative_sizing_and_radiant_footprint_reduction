"""
Hyperery REI (Hypersonics ReImagined)
Comparative Plume Footprint & Sizing Calculator
Compares an unmitigated reference vehicle plume against a mitigated low-observable vehicle 
traveling at identical hypersonic velocity.
"""

import numpy as np

def calculate_plume_reduction_metrics(
    velocity_mps=5500.0,         # Identical flight velocity (m/s)
    baseline_diameter_m=4.5,     # Unmitigated exhaust plume expansion diameter (m)
    mitigated_diameter_m=1.8,    # Mitigated plume diameter via active mixing & cooling (m)
    baseline_temp_k=2800.0,      # Unmitigated core temperature (K)
    mitigated_temp_k=1600.0      # Mitigated core temperature (K)
):
    print(f"--- Hyperery REI Comparative Plume Sizing Analysis ---")
    print(f"Flight Velocity: {velocity_mps:.1f} m/s (Hypersonic Regime)")
    
    # 1. Cross-Sectional Area Calculation (A = pi * r^2)
    baseline_area = np.pi * (baseline_diameter_m / 2.0) ** 2
    mitigated_area = np.pi * (mitigated_diameter_m / 2.0) ** 2
    area_reduction = ((baseline_area - mitigated_area) / baseline_area) * 100.0
    
    # 2. Radiative Power Scaling (Stefan-Boltzmann T^4 proportionality)
    # Radiance scales with both emitting surface area and T^4 thermal intensity
    baseline_radiant_power = baseline_area * (baseline_temp_k ** 4)
    mitigated_radiant_power = mitigated_area * (mitigated_temp_k ** 4)
    total_power_reduction = ((baseline_radiant_power - mitigated_radiant_power) / baseline_radiant_power) * 100.0
    
    print(f"\n[Geometric Sizing]")
    print(f"Baseline Plume Cross-Sectional Area: {baseline_area:.2f} m²")
    print(f"Mitigated Plume Cross-Sectional Area: {mitigated_area:.2f} m²")
    print(f"Plume Area/Volume Footprint Reduction: {area_reduction:.1f}%")
    
    print(f"\n[Radiant Intensity & Thermal Output]")
    print(f"Baseline Radiant Power Output: {baseline_radiant_power:.3e} arbitrary units")
    print(f"Mitigated Radiant Power Output: {mitigated_radiant_power:.3e} arbitrary units")
    print(f"Total Effective Thermal/Signature Reduction: {total_power_reduction:.1f}%")
    
    return {
        "area_reduction_pct": area_reduction,
        "total_power_reduction_pct": total_power_reduction
    }

if __name__ == "__main__":
    results = calculate_plume_reduction_metrics()
